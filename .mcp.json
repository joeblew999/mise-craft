{
  "mcpServers": {
    "cadcraft": {
      "command": "mise",
      "args": ["exec", "--", "cadcraft-cli", "mcp"]
    },
    "cadcraft-app": {
      "command": "mise",
      "args": ["exec", "--", "cadcraft-cli", "mcp", "--connect", "127.0.0.1:7979", "--lazy", "--launch"]
    },
    "vectorcraft": {
      "command": "mise",
      "args": ["exec", "--", "vectorcraft-cli", "mcp", "--headless"]
    },
    "vectorcraft-app": {
      "command": "mise",
      "args": ["exec", "--", "sh", "scripts/mcp-open-app.sh", "VectorCraft", "7990", "vectorcraft-cli", "mcp", "--connect", "127.0.0.1:7990"]
    }
  }
}
