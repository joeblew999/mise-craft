{
  "//": "Lineage: written by hand, the one list of Craft apps. Read by mise-tasks/gen, which generates mise.toml, .mcp.json and mcp-live.json from it, and by mise-tasks/status. An app with a live entry is checked end to end; in live, {port} stands for its port.",
  "apps": [
    {
      "id": "cadcraft",
      "name": "CADCraft",
      "version": "0.13.0",
      "port": 7979,
      "live": ["--connect", "127.0.0.1:{port}", "--lazy", "--launch"],
      "opens_itself": true
    },
    { "id": "deckcraft", "name": "DeckCraft", "version": "0.11.1" },
    {
      "id": "designcraft",
      "name": "DesignCraft",
      "version": "0.13.0",
      "port": 7981,
      "live": ["--connect", "127.0.0.1:{port}"]
    },
    {
      "id": "effectcraft",
      "name": "EffectCraft",
      "version": "0.17.0",
      "port": 7982,
      "live": ["--bridge", "{port}"]
    },
    {
      "id": "figcraft",
      "name": "FigCraft",
      "version": "0.11.2",
      "//": "Not checked yet; its usage text shows --attach PORT."
    },
    { "id": "filmcraft", "name": "FilmCraft", "version": "0.13.0" },
    {
      "id": "gridcraft",
      "name": "GridCraft",
      "version": "0.12.1",
      "port": 7985,
      "live": ["--connect", "{port}"]
    },
    { "id": "lightcraft", "name": "LightCraft", "version": "0.14.0" },
    { "id": "pdfcraft", "name": "PdfCraft", "version": "0.14.0" },
    { "id": "photocraft", "name": "PhotoCraft", "version": "0.16.0" },
    { "id": "soundcraft", "name": "SoundCraft", "version": "0.13.1" },
    {
      "id": "vectorcraft",
      "name": "VectorCraft",
      "version": "0.17.0",
      "port": 7990,
      "live": ["--connect", "127.0.0.1:{port}"],
      "headless": ["--headless"],
      "//": "Its server connects to a running app on 7979 by default, so the headless server needs --headless."
    },
    { "id": "wordcraft", "name": "WordCraft", "version": "0.11.0" }
  ]
}
