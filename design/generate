#!/usr/bin/env bash
# Design-time stage 4: generate the root's mise.toml and servers.json from family.json and apps.json.
# Validation (stage 3) runs before it and locking (stage 5) after it, both from design/mise.toml.
#
# Lineage:
#   run by   the generate task in design/mise.toml (`mise run gen` in design/ runs it, after validate)
#   reads    design/family.json, design/apps.json
#   writes   mise.toml and servers.json at the repo root, where runtime reads them. Nothing it
#            produces stays in design/.
set -euo pipefail
cd "$(dirname "$0")"

# Every app in full: family.json with the app's overrides laid over it (objects merge; arrays and
# values replace), then {id}, {name}, {version} and {port} filled in. An app with observed is checked.
full=$(jq -c --slurpfile fam family.json '
  def fill($a): walk(if type == "string"
    then gsub("\\{id\\}"; $a.id) | gsub("\\{name\\}"; $a.name) | gsub("\\{version\\}"; $a.version)
      | gsub("\\{port\\}"; ($a.port // "" | tostring))
    else . end);
  ($fam[0] | del(."//")) as $f
  | [.apps[] | . as $a | (($f * ($a.overrides // {})) | fill($a))
     + {id, name, version, port, checked: (.observed != null)}]' apps.json)

# One "id version name repo cli-asset app-asset" line per app, and the ids of the checked apps.
apps=$(jq -r '.[] | "\(.id) \(.version) \(.name) \(.repo) \(.install.cli) \(.install.app)"' <<<"$full")
checked=$(jq -r '.[] | select(.checked) | .id' <<<"$full")

mise_toml() {
  cat <<'EOF'
# Generated by design/generate from design/family.json and design/apps.json: edit those, then run
# `mise run gen` in design/.
#
# Lineage:
#   generated by   design/generate from design/family.json and design/apps.json, run by `mise run gen`
#                  in design/
#   read by        mise
#   tasks run      <app>:install / <app>:uninstall -> mise-tasks/apps/install / uninstall
#                  <app>:watch / <app>:unwatch     -> mise-tasks/apps/watch / unwatch
#   postinstall    each desktop app tool runs scripts/unpack-dmg.sh
#
# Each Craft app's GitHub repo is installed twice under aliases: `<app>-cli` (the CLI, with its MCP
# server) and `<app>` (the desktop app). Each alias gets its own install directory. macOS only for
# now: it's the one platform every app publishes a CLI for.
#
# Every app is listed, but nothing downloads until you name it: `mise run cadcraft:install`.
# (A bare `mise install` still installs them all.)

[settings]
# Don't install missing tools behind your back: not when .mcp.json starts a server with
# `mise exec`, not on `mise run`, and not when a shell can't find a command.
exec_auto_install = false
task.run_auto_install = false
not_found_auto_install = false

[tool_alias]
EOF
  while read -r id _ _ repo _ _; do
    printf '%s-cli = "github:%s"\n%s = "github:%s"\n' "$id" "$repo" "$id" "$repo"
  done <<<"$apps"

  printf '\n[tools]\njq = "1.8.2" # for the tasks in mise-tasks/ and design/\ngh = "2.103.0" # for design/fetch\n'
  while read -r id version _ _ cli app; do
    printf '%s-cli = { version = "%s", asset_pattern = "%s", os = ["macos"] }\n' "$id" "$version" "$cli"
    printf '%s = { version = "%s", asset_pattern = "%s", os = ["macos"], postinstall = '"'"'sh "{{ config_root }}/scripts/unpack-dmg.sh"'"'"' }\n' "$id" "$version" "$app"
  done <<<"$apps"

  while read -r id version name _ _ _; do
    if grep -qx "$id" <<<"$checked"; then
      cat <<EOF

[tasks."$id:watch"]
description = "Let Claude drive the $name desktop app while you watch: adds its live MCP server to Claude Code for this project. Undo with $id:unwatch."
run = "mise run apps:watch $id"

[tasks."$id:unwatch"]
description = "Remove $name's live MCP server from Claude Code."
run = "mise run apps:unwatch $id"
EOF
    fi
    cat <<EOF

[tasks."$id:install"]
description = "Install $name $version: its CLI ($id-cli, with the MCP server) and desktop app. Undo with $id:uninstall."
run = "mise run apps:install $id"

[tasks."$id:uninstall"]
description = "Uninstall $name: every installed version of its CLI and desktop app, unregistered from macOS."
run = "mise run apps:uninstall $id"
EOF
  done <<<"$apps"
}

# The headless and live server of each checked app, for every host. Apps that can't open themselves
# go through scripts/mcp-open-app.sh, which opens the app with its control port first; hosts run
# these from the repo root, so the script's path is relative to that.
servers_json() {
  jq '{
    "//": [
      "Generated by design/generate from design/family.json and design/apps.json: edit those, then run `mise run gen` in design/.",
      "The MCP servers of every checked app, for every host: headless servers work on a document with no window; live servers drive the running desktop app.",
      "Read by: mise-tasks/claude/sync (writes .mcp.json for the apps installed here), mise-tasks/apps/watch (adds one live server to Claude Code)."
    ],
    headless: ([.[] | select(.checked) | {key: .id,
      value: {command: "mise", args: (["exec", "--", .install.cli_bin, "mcp"] + .mcp.headless)}}] | from_entries),
    live: ([.[] | select(.checked) | {key: "\(.id)-app",
      value: {command: "mise", args: (
        if .mcp.opens_itself then ["exec", "--", .install.cli_bin, "mcp"] + .mcp.live
        else ["exec", "--", "sh", "scripts/mcp-open-app.sh", (.bundle.name | rtrimstr(".app")), (.port | tostring),
          .install.cli_bin, "mcp"] + .mcp.live
        end)}}] | from_entries)
  }' <<<"$full"
}

# Generate everything into a temporary folder first, so a failed run leaves the files as they were.
tmp=$(mktemp -d)
trap 'rm -f "$tmp"/mise.toml "$tmp"/servers.json; rmdir "$tmp"' EXIT
mise_toml >"$tmp/mise.toml"
servers_json >"$tmp/servers.json"
cat "$tmp/mise.toml" >../mise.toml
cat "$tmp/servers.json" >../servers.json
