#!/usr/bin/env bash
# Design-time stage 1, upstream:fetch: read each app's latest release and docs from GitHub and print,
# per app, the version pinned and the latest, the port its own docs use, whether it documents its MCP
# server, and the platforms its CLI and desktop app are published for, for the maintainer to act on
# (stage 3).
#
# Lineage:
#   run by   `mise run upstream:fetch` in design/ (design/mise.toml)
#   reads    design/apps.json, design/family.json and design/scripts/app-merge.jq (each app's version, repo,
#            docs, control option and asset names); GitHub through gh (each repo's latest release,
#            README and docs)
#   writes   nothing: it prints a table
set -euo pipefail
cd "$(dirname "$0")/.."  # design/, where the registry is

# The OS and architecture in a release asset's name, such as macos-universal or linux-x86_64. The
# desktop app's assets are the app's other assets, except its web build (<app>-web-*), which this repo
# doesn't use.
platform='(capture("-(?<p>(macos|linux|windows|freebsd)-[a-z0-9_]+)") | .p)?'

row='%-12s %-8s %-8s %-9s %-4s %-16s %s\n'
printf "$row" APP PINNED LATEST "DOCS PORT" DOCS "CLI PLATFORMS" "APP PLATFORMS"
for id in $(jq -r '.apps[].id' apps.json); do
  app=$(jq -c --arg id "$id" --slurpfile fam family.json -L scripts 'include "app-merge"; .apps[] | select(.id == $id) | full($fam[0])' apps.json)
  repo=$(jq -r .repo <<<"$app")
  mcp_doc=$(jq -r .docs.mcp <<<"$app")
  control_doc=$(jq -r .docs.control <<<"$app")
  control=$(jq -r .control <<<"$app")
  # The start of the CLI's and the desktop app's asset names, such as cadcraft-cli- and cadcraft-.
  cli_prefix=$(jq -r '.install.cli | split("*")[0]' <<<"$app")
  app_prefix=$(jq -r '.install.app | split("*")[0]' <<<"$app")
  release=$(gh release view -R "$repo" --json tagName,assets)
  docs=-
  if gh api "repos/$repo/contents/$mcp_doc" --silent 2>/dev/null; then docs=yes; fi
  # The first `<app> --control <port>` in the README and the docs is the port the docs use.
  text=$( {
    gh api "repos/$repo/readme" --jq .content | base64 -d
    for f in "$mcp_doc" "$control_doc"; do
      gh api "repos/$repo/contents/$f" --jq .content 2>/dev/null | base64 -d 2>/dev/null || true
    done
  } )
  port=$(grep -o -E -- "$id $control [0-9]+" <<<"$text" | head -1 | grep -o -E '[0-9]+$' || true)
  latest=$(jq -r '.tagName | ltrimstr("v")' <<<"$release")
  cli_platforms=$(jq -r --arg cli "$cli_prefix" "[.assets[].name | select(startswith(\$cli)) | $platform] | unique | join(\",\")" <<<"$release")
  app_platforms=$(jq -r --arg cli "$cli_prefix" --arg app "$app_prefix" --arg web "$id-web-" \
    "[.assets[].name | select(startswith(\$app) and (startswith(\$cli) or startswith(\$web) | not)) | $platform] | unique | join(\",\")" <<<"$release")
  printf "$row" "$id" "$(jq -r .version <<<"$app")" "$latest" "${port:--}" "$docs" "$cli_platforms" "$app_platforms"
done
