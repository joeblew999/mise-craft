#!/usr/bin/env bash
# Design-time stage 2, app:check: run one installed app and print what it showed, for the maintainer
# to record (stage 3): its usage line, whether its bundle is what design/family.json and its overrides
# say, the tools its headless and live servers list, and whether its file access can be confined.
# It's the one stage that runs something on the machine: the app's CLI, its headless MCP server, and
# its live server (which opens the desktop app; app:check closes it again if it wasn't open before).
#
# Lineage:
#   run by   `mise run app:check <app>` in design/ (design/mise.toml)
#   reads    design/family.json, design/apps.json, design/scripts/app-merge.jq; the app's installed CLI and bundle
#   runs     the app's CLI and both its MCP servers, the live one through scripts/app-open.sh
#   writes   nothing: it prints what it found, and exits non-zero if something didn't work
set -euo pipefail
cd "$(dirname "$0")/.."  # design/, where the registry is
id=${1:?usage: 2-app-check <app>}
app=$(jq -c --arg id "$id" --slurpfile fam family.json -L scripts 'include "app-merge"; .apps[] | select(.id == $id) | full($fam[0])' apps.json)
[ -n "$app" ] || { echo "$id is not in apps.json" >&2; exit 1; }
cli=$(jq -r '.install.cli_bin' <<<"$app")
sub=$(jq -r '.mcp.subcommand' <<<"$app")
control=$(jq -r '.control' <<<"$app")
token_env=$(jq -r '.control_token_env // "-"' <<<"$app")
port=$(jq -r '.port // empty' <<<"$app")
mise which "$cli" >/dev/null 2>&1 || { echo "$id is not installed: run mise run $id:install at the repo root first" >&2; exit 1; }

# The CLI's help, from every place a CLI might put it (some list the subcommand's options only
# under `mcp --help`, some only when given an option they don't know). No input: a CLI that starts
# its server instead of printing help (SoundCraft's `mcp --help`) then sees the end of it and stops.
help=$( { mise exec -- "$cli" --help 2>&1 || true; mise exec -- "$cli" "$sub" --help 2>&1 || true
  mise exec -- "$cli" "$sub" --no-such-option 2>&1 || true; } </dev/null )
# usage: the help's lines about the subcommand, as they are (spaces squeezed), up to two.
usage=$(grep -E "^[[:space:]]*(Usage:[[:space:]]*)?($cli[[:space:]]+)?$sub([[:space:]]|$)" <<<"$help" \
  | sed -E 's/^[[:space:]]*(Usage:[[:space:]]*)?//; s/[[:space:]]+/ /g; s/ $//' | awk '!seen[$0]++' | head -2 \
  | awk 'NR > 1 { printf "  ·  " } { printf "%s", $0 } END { print "" }')
[ -n "$usage" ] || { echo "could not find $cli's $sub usage line" >&2; exit 1; }

# bundle: from the installed app itself.
dir=$(mise where "$id")
bundle_name=$(cd "$dir" && ls -d *.app | head -1)
executable=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "$dir/$bundle_name/Contents/Info.plist")

# The tool names an MCP server lists, given its command.
tools() {
  { printf '%s\n' \
      '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"check","version":"0"}}}' \
      '{"jsonrpc":"2.0","method":"notifications/initialized"}' \
      '{"jsonrpc":"2.0","id":2,"method":"tools/list"}'
    sleep 10; } \
    | (cd .. && perl -e 'alarm 60; exec @ARGV' "$@" 2>/dev/null) \
    | jq -c 'select(.id == 2) | [.result.tools[].name] | sort'
}
# A server that doesn't answer leaves its list empty; the check after it says so.
headless=$(tools mise exec -- "$cli" "$sub" $(jq -r '.mcp.headless[]' <<<"$app")) || true
[ -n "$headless" ] || { echo "$id's headless server didn't answer" >&2; exit 1; }

live='null'
if [ "$(jq -r '.mcp.live' <<<"$app")" = null ]; then
  echo "$id has no live server (its overrides set mcp.live to null), so there's none to check" >&2
elif [ -n "$port" ]; then
  # Close the app again on the way out, pass or fail, if this check is what opened it.
  if ! pgrep -x "$executable" >/dev/null; then
    trap 'pkill -f "$dir/$bundle_name/Contents/MacOS/" 2>/dev/null || true' EXIT
  fi
  live=$(tools mise exec -- sh scripts/app-open.sh "${bundle_name%.app}" "$control" "$port" "$token_env" \
    "$cli" "$sub" $(jq -r '.mcp.live[]' <<<"$app")) || true
  [ -n "$live" ] || { echo "$id's live server didn't answer on port $port" >&2; exit 1; }
else
  echo "$id has no port in apps.json yet, so its live server isn't checked" >&2
fi

# What the app showed. A bundle that differs from family.json and the app's overrides needs an override.
want_name=$(jq -r '.bundle.name' <<<"$app")
want_exe=$(jq -r '.bundle.executable' <<<"$app")
failed=0
row() { printf '%-11s %s\n' "$1" "$2"; }
row app "$id $(jq -r .version <<<"$app"), checked: $(jq -r --arg id "$id" '.apps[] | select(.id == $id) | .checked // "no"' apps.json)"
row usage "$usage"
if [ "$bundle_name" = "$want_name" ] && [ "$executable" = "$want_exe" ]; then
  row bundle "$bundle_name, executable $executable, as family.json and its overrides say"
else
  row bundle "$bundle_name, executable $executable, but family.json and its overrides say $want_name, $want_exe: needs an override"
  failed=1
fi
row headless "$(jq -r 'length' <<<"$headless") tools: $(jq -r 'join(", ")' <<<"$headless")"
if [ "$live" != null ]; then
  row live "$(jq -r 'length' <<<"$live") tools on port $port; only here: $(jq -r --argjson h "$headless" '(. - $h) | if length == 0 then "none" else join(", ") end' <<<"$live")"
fi
row look "$(jq -r -n --argjson h "$headless" --argjson l "$live" '[($h + ($l // []))[] | select(test("screenshot|render|export_png"))] | unique | join(", ")')"
row "file roots" "$(grep -q -- --automation-read-root <<<"$help" && echo "can be confined (--automation-read-root / --automation-write-root)" || echo "cannot be confined")"
exit "$failed"
