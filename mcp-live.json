{
  "//": "Lineage: written by hand. Read by mise-tasks/apps/watch, which copies one entry into Claude Code, and by scripts/gen-mise-toml.sh, which gives each app listed here watch and unwatch tasks. Every entry but CADCraft runs scripts/mcp-open-app.sh.",
  "mcpServers": {
    "cadcraft-app": {
      "command": "mise",
      "args": [
        "exec",
        "--",
        "cadcraft-cli",
        "mcp",
        "--connect",
        "127.0.0.1:7979",
        "--lazy",
        "--launch"
      ]
    },
    "designcraft-app": {
      "command": "mise",
      "args": [
        "exec",
        "--",
        "sh",
        "scripts/mcp-open-app.sh",
        "DesignCraft",
        "7981",
        "designcraft-cli",
        "mcp",
        "--connect",
        "127.0.0.1:7981"
      ]
    },
    "effectcraft-app": {
      "command": "mise",
      "args": [
        "exec",
        "--",
        "sh",
        "scripts/mcp-open-app.sh",
        "EffectCraft",
        "7982",
        "effectcraft-cli",
        "mcp",
        "--bridge",
        "7982"
      ]
    },
    "gridcraft-app": {
      "command": "mise",
      "args": [
        "exec",
        "--",
        "sh",
        "scripts/mcp-open-app.sh",
        "GridCraft",
        "7985",
        "gridcraft-cli",
        "mcp",
        "--connect",
        "7985"
      ]
    },
    "vectorcraft-app": {
      "command": "mise",
      "args": [
        "exec",
        "--",
        "sh",
        "scripts/mcp-open-app.sh",
        "VectorCraft",
        "7990",
        "vectorcraft-cli",
        "mcp",
        "--connect",
        "127.0.0.1:7990"
      ]
    }
  }
}
