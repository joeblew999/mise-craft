#!/usr/bin/env bash
#MISE description="Install Craft apps by name, each with its CLI: `mise run apps:install cadcraft vectorcraft`. Undo with apps:uninstall."
#USAGE arg "<app>" var=#true help="An app from mise.toml, such as cadcraft"
# Lineage:
#   run by   `mise run <app>:install` (mise.toml), or directly
#   runs     `mise install <app> <app>-cli`; mise then runs scripts/unpack-dmg.sh as the
#            desktop app's postinstall
#   undone   mise-tasks/apps/uninstall
set -euo pipefail
for app in $usage_app; do
  mise install "$app" "$app-cli"
done
