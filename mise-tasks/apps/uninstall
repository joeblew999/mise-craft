#!/usr/bin/env bash
#MISE description="Uninstall Craft apps by name: stop watching them, remove every installed version of the app and its CLI, unregister the apps from macOS, and take their servers out of Claude Code: `mise run apps:uninstall cadcraft`."
#USAGE arg "<app>" var=#true help="An app from mise.toml, such as cadcraft"
# Lineage:
#   run by   `mise run <app>:uninstall` (mise.toml), or directly
#   runs     mise-tasks/apps/unwatch (only removes a live server this repo added), lsregister -u
#            (undoes scripts/dmg-unpack.sh's registration), `mise uninstall --all <app> <app>-cli`,
#            then mise-tasks/claude-code/sync, which rewrites .mcp.json
#   undoes   mise-tasks/apps/install
set -euo pipefail
lsregister=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
installs=${MISE_DATA_DIR:-$HOME/.local/share/mise}/installs
for app in $usage_app; do
  # A live server for an app that is gone could only fail, so stop watching it first.
  mise run apps:unwatch "$app"
  # Undo scripts/dmg-unpack.sh's registration before the .app is deleted.
  for version in "$installs/$app"/*; do
    [ -d "$version" ] && [ ! -L "$version" ] || continue
    for bundle in "$version"/*.app; do
      [ -d "$bundle" ] && "$lsregister" -u "$bundle" && echo "unregistered $bundle"
    done
  done
  mise uninstall --all "$app" "$app-cli"
done
mise run claude-code:sync
