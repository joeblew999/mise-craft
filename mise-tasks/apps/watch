#!/usr/bin/env bash
#MISE description="Add installed apps' live MCP servers (from servers.json) to Claude Code for this project only, so Claude drives the desktop app while you watch: `mise run apps:watch cadcraft`. Undo with apps:unwatch."
#USAGE arg "<app>" var=#true help="A checked, installed app, such as cadcraft"
# Lineage:
#   run by   `mise run <app>:watch` (mise.toml), or directly
#   reads    servers.json, ~/.claude.json; `mise which` (refuses an app that is not installed)
#   runs     `claude mcp add-json --scope local`, which writes this project's entry in
#            ~/.claude.json; Claude Code then starts the server, via scripts/app-open.sh
#            for apps that can't open themselves
#   undone   mise-tasks/apps/unwatch
set -euo pipefail
# Claude Code keeps its config in ~/.claude.json, or in $CLAUDE_CONFIG_DIR when that is set.
root=$(cd "$(dirname "$0")/../.." && pwd)
cd "$root"
# Every server watch adds carries this env var. A server of the same name without it was added by
# someone else, so watch and unwatch leave it alone.
marker=MISE_CRAFT_WATCH
for app in $usage_app; do
  name="$app-app"
  server=$(jq -c --arg n "$name" --arg m "$marker" \
    '.live[$n] // empty | .env = ((.env // {}) + {($m): "1"})' servers.json)
  [ -n "$server" ] || { echo "$app has no live server in servers.json: it isn't checked yet, or it has none" >&2; exit 1; }
  mise which "$app-cli" >/dev/null 2>&1 || { echo "$app is not installed: run mise run $app:install first" >&2; exit 1; }
  existing=$(jq -c --arg root "$root" --arg n "$name" \
    '.projects[$root].mcpServers[$n] // empty' "${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json" 2>/dev/null || true)
  if [ -n "$existing" ]; then
    if [ "$(jq -r --arg m "$marker" '.env[$m] // empty' <<<"$existing")" != 1 ]; then
      echo "Claude Code already has a server named $name that this repo didn't add; leaving it alone." >&2
      exit 1
    fi
    # Ours: replace it, so it matches the current servers.json.
    claude mcp remove --scope local "$name" >/dev/null
  fi
  claude mcp add-json --scope local "$name" "$server"
done
echo "Start a new Claude Code session (or use /mcp) to load them."
