#!/usr/bin/env bash
#MISE description="Write .mcp.json, Claude Code's project servers, from servers.json: the headless server of each checked app that is installed here. Run by <app>:install and <app>:uninstall."
# Lineage:
#   run by   mise-tasks/apps/install and uninstall, or `mise run claude:sync`
#   reads    servers.json; `mise ls` (which CLIs are installed here)
#   writes   .mcp.json, a runtime file in the repo folder that is not committed (.gitignore)
set -euo pipefail
cd "$(dirname "$0")/../.."
installed=$(mise ls --json 2>/dev/null | jq -c '[to_entries[] | select(any(.value[]; .installed)) | .key]')
jq --argjson installed "$installed" '{
  "//": [
    "Generated at runtime by mise-tasks/claude/sync from servers.json and the apps installed on this machine; not committed. <app>:install and <app>:uninstall rewrite it.",
    "Read by: Claude Code (and VS Code) at session start, mise-tasks/desktop/install and mise-tasks/status."
  ],
  mcpServers: (.headless | with_entries(select(.key + "-cli" as $c | $installed | index($c))))
}' servers.json >.mcp.json.tmp
cat .mcp.json.tmp >.mcp.json
rm .mcp.json.tmp
echo "Claude Code servers: $(jq -r '.mcpServers | keys | join(", ") | if . == "" then "none" else . end' .mcp.json)"
