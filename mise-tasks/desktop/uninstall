#!/usr/bin/env bash
#MISE description="Remove the MCP servers desktop:install added to Claude Desktop, leaving the rest of its config as it was. Quit Claude Desktop first."
# Lineage:
#   run by   `mise run desktop:uninstall`
#   writes   ~/Library/Application Support/Claude/claude_desktop_config.json
#   undoes   mise-tasks/desktop/install
set -euo pipefail
root=$(cd "$(dirname "$0")/../.." && pwd)
config=${CLAUDE_DESKTOP_CONFIG:-"$HOME/Library/Application Support/Claude/claude_desktop_config.json"}
if [ -z "${CLAUDE_DESKTOP_CONFIG:-}" ] && pgrep -x Claude >/dev/null; then
  echo "Quit Claude Desktop first: it rewrites its config while running and could drop this change." >&2
  exit 1
fi
[ -f "$config" ] || exit 0

# Our entries are the ones desktop:install pointed at this repo with `-C <repo>`.
mine='(.mcpServers // {}) | to_entries[] | select(.value.args[0:2] == ["-C", $root]) | .key'
removed=$(jq -r --arg root "$root" "$mine" "$config")
[ -n "$removed" ] || { echo "nothing to remove"; exit 0; }
printf '%s' "$(jq --arg root "$root" '.mcpServers |= with_entries(select(.value.args[0:2] != ["-C", $root]))' "$config")" >"$config"
printf 'removed %s\n' $removed
