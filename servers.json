{
  "//": [
    "Generated by design/generate from design/family.json and design/apps.json: edit those, then run `mise run gen` in design/.",
    "The MCP servers of every checked app, for every host: headless servers work on a document with no window; live servers drive the running desktop app.",
    "Read by: mise-tasks/claude/sync (writes .mcp.json for the apps installed here), mise-tasks/apps/watch (adds one live server to Claude Code)."
  ],
  "headless": {
    "cadcraft": {
      "command": "mise",
      "args": [
        "exec",
        "--",
        "cadcraft-cli",
        "mcp"
      ]
    },
    "deckcraft": {
      "command": "mise",
      "args": [
        "exec",
        "--",
        "deckcraft-cli",
        "mcp"
      ]
    },
    "designcraft": {
      "command": "mise",
      "args": [
        "exec",
        "--",
        "designcraft-cli",
        "mcp"
      ]
    },
    "effectcraft": {
      "command": "mise",
      "args": [
        "exec",
        "--",
        "effectcraft-cli",
        "mcp"
      ]
    },
    "figcraft": {
      "command": "mise",
      "args": [
        "exec",
        "--",
        "figcraft-cli",
        "mcp"
      ]
    },
    "gridcraft": {
      "command": "mise",
      "args": [
        "exec",
        "--",
        "gridcraft-cli",
        "mcp"
      ]
    },
    "vectorcraft": {
      "command": "mise",
      "args": [
        "exec",
        "--",
        "vectorcraft-cli",
        "mcp",
        "--headless"
      ]
    }
  },
  "live": {
    "cadcraft-app": {
      "command": "mise",
      "args": [
        "exec",
        "--",
        "cadcraft-cli",
        "mcp",
        "--connect",
        "127.0.0.1:7979",
        "--lazy",
        "--launch"
      ]
    },
    "deckcraft-app": {
      "command": "mise",
      "args": [
        "exec",
        "--",
        "sh",
        "scripts/mcp-open-app.sh",
        "DeckCraft",
        "7980",
        "deckcraft-cli",
        "mcp",
        "--connect",
        "7980"
      ]
    },
    "designcraft-app": {
      "command": "mise",
      "args": [
        "exec",
        "--",
        "sh",
        "scripts/mcp-open-app.sh",
        "DesignCraft",
        "7981",
        "designcraft-cli",
        "mcp",
        "--connect",
        "127.0.0.1:7981"
      ]
    },
    "effectcraft-app": {
      "command": "mise",
      "args": [
        "exec",
        "--",
        "sh",
        "scripts/mcp-open-app.sh",
        "EffectCraft",
        "7982",
        "effectcraft-cli",
        "mcp",
        "--bridge",
        "7982"
      ]
    },
    "figcraft-app": {
      "command": "mise",
      "args": [
        "exec",
        "--",
        "sh",
        "scripts/mcp-open-app.sh",
        "FigCraft",
        "7983",
        "figcraft-cli",
        "mcp",
        "--attach",
        "7983"
      ]
    },
    "gridcraft-app": {
      "command": "mise",
      "args": [
        "exec",
        "--",
        "sh",
        "scripts/mcp-open-app.sh",
        "GridCraft",
        "7985",
        "gridcraft-cli",
        "mcp",
        "--connect",
        "7985"
      ]
    },
    "vectorcraft-app": {
      "command": "mise",
      "args": [
        "exec",
        "--",
        "sh",
        "scripts/mcp-open-app.sh",
        "VectorCraft",
        "7990",
        "vectorcraft-cli",
        "mcp",
        "--connect",
        "127.0.0.1:7990"
      ]
    }
  }
}
